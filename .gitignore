# Unreal Engine generated files
Binaries/
DerivedDataCache/
Intermediate/
Saved/
ExamplesContent/

# Generated project files
*.sln
# .slnx 是 VS 新版的解决方案格式，与 .sln 同样由 UBT 生成，不该进版本库
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.ipch

# IDE and editor caches
.vs/
.vscode/
.idea/
*.code-workspace

# Packaged builds, but keep project build scripts
Build/*
!Build/*/
!Build/*/Scripts/

# Plugin generated files
Plugins/*/Binaries/
Plugins/*/Intermediate/

# OS files
Thumbs.db
Desktop.ini
.DS_Store
